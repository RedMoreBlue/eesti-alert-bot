# Copy to /etc/eesti-alert-bot.env and fill in. Keep it private:
# anyone with the webhook URL can post to your channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY
# How often to check the API, in seconds. Default 300 (5 min), minimum 60.
# This is the Eesti äpp's own backend with no published limits: please don't go lower.
POLL_SECONDS=300

# Discord role IDs (numbers, not names). Get one with Developer Mode on:
# Server Settings > Roles > right-click the role > Copy Role ID.
# Leave a line empty if you don't have that role; it just won't be pinged.

# Pinged on every alert, wherever it is.
ROLE_ALL=

# Pinged when an alert covers that county.
ROLE_HARJU=
ROLE_HIIU=
ROLE_IDA_VIRU=
ROLE_JOGEVA=
ROLE_JARVA=
ROLE_LAANE=
ROLE_LAANE_VIRU=
ROLE_POLVA=
ROLE_PARNU=
ROLE_RAPLA=
ROLE_SAARE=
ROLE_TARTU=
ROLE_VALGA=
ROLE_VILJANDI=
ROLE_VORU=
