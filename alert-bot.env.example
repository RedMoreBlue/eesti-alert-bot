# Copy to /etc/eesti-alert-bot.env and fill in. Keep it private:
# anyone with the webhook URL can post to your channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY
POLL_SECONDS=20

# Optional: ID of an opt-in role (e.g. @ohuteavitus) to ping on every alert and test.
# Discord: Settings > Advanced > Developer Mode on, then Server Settings > Roles >
# right-click the role > Copy Role ID. Leave empty for no role ping.
PING_ROLE_ID=

# Ping @everyone on real alerts too (true/false). Set to false for role-only pings.
PING_EVERYONE=true
